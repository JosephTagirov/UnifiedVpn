[Unit]
Description=Synchronize primary VLESS identities to the standby
After=network-online.target x-ui.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/unifiedvpn-failover/vless_sync.py run --config /etc/unifiedvpn-failover/vless-source.json
TimeoutStartSec=180
UMask=0077
Nice=10
MemoryMax=128M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/unifiedvpn-failover
