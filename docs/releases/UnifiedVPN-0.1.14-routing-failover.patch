+++ b/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/HappEntryFailoverConfig.kt
@@ -0,0 +1,96 @@
+package org.olcbox.app.vpn
+
+import java.net.URI
+import kotlinx.serialization.json.*
+import org.olcbox.app.data.model.VpnEntryEndpoint
+import org.olcbox.app.data.model.VpnProfileConfig
+
+/** Standalone Xray JSON for Happ, whose runner passes imported JSON to the core unchanged. */
+internal object HappEntryFailoverConfig {
+    const val PRIMARY_TAG = "entry-primary"
+    const val BACKUP_TAG = "entry-backup"
+    const val BALANCER_TAG = "entry-auto"
+    private val json = Json { prettyPrint = true }
+
+    /**
+     * Native observatory uses one failed/successful HTTPS request, without the app policy's hold time.
+     * Literal entry IPs avoid depending on the runner's bootstrap DNS when its TUN is active.
+     */
+    fun build(
+        profile: VpnProfileConfig,
+        primaryEndpoint: VpnEntryEndpoint,
+        backupEndpoint: VpnEntryEndpoint,
+        socksPort: Int = 10808,
+        httpPort: Int = 10809,
+        probeUrl: String = "https://www.gstatic.com/generate_204",
+        probeIntervalSeconds: Int = 10
+    ): String {
+        val primary = primaryEndpoint.normalizedOrNull() ?: error("Invalid primary entry endpoint")
+        val backup = backupEndpoint.normalizedOrNull() ?: error("Invalid backup entry endpoint")
+        require(primary.host != backup.host || primary.port != backup.port) { "Entry endpoints must differ" }
+        require(socksPort in 1..65535 && httpPort in 1..65535 && socksPort != httpPort) { "Invalid Happ listener ports" }
+        val probe = URI(probeUrl)
+        require(probe.scheme == "https" && !probe.host.isNullOrBlank() && probe.rawUserInfo == null &&
+            probe.rawFragment == null && probe.port in -1..65535 && probe.port != 0) { "An HTTPS health URL is required" }
+        require(probeIntervalSeconds in 1..3600) { "Invalid health interval" }
+        require(XrayVlessConfig.downloadEndpointHost(profile) == null) {
+            "Entry failover cannot replace a separate XHTTP download endpoint"
+        }
+        val cleanProfile = profile.copy(entryFailover = null)
+        fun outbound(endpoint: VpnEntryEndpoint, tag: String): JsonObject {
+            val base = Json.parseToJsonElement(XrayVlessConfig.build(cleanProfile,
+                XraySocksSettings(port = socksPort), endpointAddress = endpoint.host)).jsonObject
+            val original = base.getValue("outbounds").jsonArray.first().jsonObject
+            val stream = original.getValue("streamSettings").jsonObject
+            require(stream["security"] in setOf(JsonPrimitive("tls"), JsonPrimitive("reality"))) {
+                "Entry failover requires verified transport security"
+            }
+            require(stream["tlsSettings"]?.jsonObject?.get("allowInsecure") != JsonPrimitive(true)) {
+                "Entry failover requires certificate verification"
+            }
+            val settings = original.getValue("settings").jsonObject
+            val peer = settings.getValue("vnext").jsonArray.single().jsonObject
+            val pinnedPeer = JsonObject(peer + ("port" to JsonPrimitive(endpoint.port)))
+            val pinnedSettings = JsonObject(settings + ("vnext" to JsonArray(listOf(pinnedPeer))))
+            return JsonObject(original + mapOf("tag" to JsonPrimitive(tag), "settings" to pinnedSettings))
+        }
+        fun inbound(port: Int, protocol: String) = buildJsonObject {
+            put("tag", protocol)
+            put("listen", "127.0.0.1")
+            put("port", port)
+            put("protocol", protocol)
+            put("settings", buildJsonObject {
+                if (protocol == "socks") { put("auth", "noauth"); put("udp", true) }
+            })
+        }
+        val root = buildJsonObject {
+            put("log", buildJsonObject { put("loglevel", "warning"); put("dnsLog", false) })
+            put("inbounds", buildJsonArray { add(inbound(socksPort, "socks")); add(inbound(httpPort, "http")) })
+            put("outbounds", buildJsonArray {
+                // Unmatched or failed routing never falls through to a direct internet connection.
+                add(buildJsonObject { put("tag", "entry-block"); put("protocol", "blackhole") })
+                add(outbound(primary, PRIMARY_TAG)); add(outbound(backup, BACKUP_TAG))
+            })
+            put("observatory", buildJsonObject {
+                put("subjectSelector", buildJsonArray { add(JsonPrimitive(PRIMARY_TAG)) })
+                put("probeURL", probeUrl)
+                put("probeInterval", "${probeIntervalSeconds}s")
+                put("enableConcurrency", true)
+            })
+            put("routing", buildJsonObject {
+                put("domainStrategy", "AsIs")
+                // Include any TUN inbound supplied by the host app, as well as these local proxies.
+                put("rules", buildJsonArray { add(buildJsonObject {
+                    put("type", "field"); put("network", "tcp,udp"); put("balancerTag", BALANCER_TAG)
+                }) })
+                put("balancers", buildJsonArray { add(buildJsonObject {
+                    put("tag", BALANCER_TAG)
+                    put("selector", buildJsonArray { add(JsonPrimitive(PRIMARY_TAG)) })
+                    put("fallbackTag", BACKUP_TAG)
+                    put("strategy", buildJsonObject { put("type", "random") })
+                }) })
+            })
+        }
+        return json.encodeToString(JsonElement.serializer(), root)
+    }
+}
diff --git a/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/ManagedEntryDns.kt b/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/ManagedEntryDns.kt
new file mode 100644
index 0000000..3c54f6d
--- /dev/null
+++ b/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/ManagedEntryDns.kt
@@ -0,0 +1,134 @@
+package org.olcbox.app.vpn
+
+import java.io.ByteArrayOutputStream
+import java.io.DataOutputStream
+import java.security.SecureRandom
+import java.util.Locale
+
+/** Only the dedicated owned entry is resolved here. An unavailable DNS server cannot disable the backup. */
+internal object ManagedEntryDns {
+    const val PRIMARY_HOST = "ru1-kvn.meesharr.space"
+    const val FALLBACK_PRIMARY_IP = "178.208.70.181"
+    const val BACKUP_IP = "48.103.218.29"
+    const val QUERY_TIMEOUT_MS = 1_200
+    private val servers = listOf("1.1.1.1", "8.8.8.8")
+    private val random = SecureRandom()
+
+    fun resolve(exchange: (server: String, request: ByteArray) -> ByteArray?): String {
+        for (server in servers) {
+            val query = query(random.nextInt(65536))
+            val response = runCatching { exchange(server, query.copyOf()) }.getOrNull() ?: continue
+            addresses(query, response).firstOrNull { it != BACKUP_IP }?.let { return it }
+        }
+        return FALLBACK_PRIMARY_IP
+    }
+
+    internal fun query(id: Int): ByteArray {
+        require(id in 0..65535)
+        val bytes = ByteArrayOutputStream()
+        DataOutputStream(bytes).use { out ->
+            for (value in listOf(id, 0x0100, 1, 0, 0, 0)) out.writeShort(value)
+            for (label in PRIMARY_HOST.split('.')) {
+                out.writeByte(label.length)
+                out.write(label.toByteArray(Charsets.US_ASCII))
+            }
+            out.writeByte(0)
+            out.writeShort(1)
+            out.writeShort(1)
+        }
+        return bytes.toByteArray()
+    }
+
+    internal fun addresses(query: ByteArray, response: ByteArray): List<String> = runCatching {
+        require(response.size in 12..4096 && query.size >= 12)
+        fun word(offset: Int): Int {
+            require(offset >= 0 && offset + 2 <= response.size)
+            return ((response[offset].toInt() and 255) shl 8) or (response[offset + 1].toInt() and 255)
+        }
+        require(response[0] == query[0] && response[1] == query[1])
+        val flags = word(2)
+        require(flags and 0x8000 != 0 && flags and 0x7800 == 0 && flags and 0x0200 == 0 && flags and 15 == 0)
+        require(word(4) == 1)
+        val answers = word(6)
+        val total = answers + word(8) + word(10)
+        require(answers in 1..128 && total <= 128)
+        fun name(start: Int): Pair<String, Int> {
+            var position = start
+            var end: Int? = null
+            val labels = mutableListOf<String>()
+            val visited = mutableSetOf<Int>()
+            repeat(128) {
+                require(position in response.indices && visited.add(position))
+                val length = response[position].toInt() and 255
+                if (length and 0xc0 == 0xc0) {
+                    require(position + 1 < response.size)
+                    if (end == null) end = position + 2
+                    position = ((length and 63) shl 8) or (response[position + 1].toInt() and 255)
+                } else {
+                    require(length <= 63)
+                    position++
+                    if (length == 0) {
+                        val result = labels.joinToString(".").lowercase(Locale.ROOT)
+                        require(result.isNotEmpty() && result.length <= 253)
+                        return result to (end ?: position)
+                    }
+                    require(position + length <= response.size)
+                    val label = response.copyOfRange(position, position + length).toString(Charsets.US_ASCII)
+                    require(label.all { it in 'a'..'z' || it in 'A'..'Z' || it in '0'..'9' || it == '-' || it == '_' })
+                    labels += label
+                    position += length
+                }
+            }
+            error("DNS name exceeds its bound")
+        }
+        val question = name(12)
+        require(question.first == PRIMARY_HOST && word(question.second) == 1 && word(question.second + 2) == 1)
+        var position = question.second + 4
+        val aliases = mutableMapOf<String, String>()
+        val values = mutableMapOf<String, MutableList<String>>()
+        repeat(total) { index ->
+            val owner = name(position)
+            position = owner.second
+            require(position + 10 <= response.size)
+            val type = word(position)
+            val klass = word(position + 2)
+            val length = word(position + 8)
+            position += 10
+            val end = position + length
+            require(end <= response.size)
+            if (index < answers && klass == 1) when (type) {
+                1 -> {
+                    require(length == 4)
+                    val address = response.copyOfRange(position, end).joinToString(".") { (it.toInt() and 255).toString() }
+                    if (isPublicIpv4(address)) values.getOrPut(owner.first) { mutableListOf() }.add(address)
+                }
+                5 -> {
+                    val target = name(position)
+                    require(target.second == end)
+                    require(aliases[owner.first] == null || aliases[owner.first] == target.first)
+                    aliases[owner.first] = target.first
+                }
+            }
+            position = end
+        }
+        require(position == response.size)
+        var owner = PRIMARY_HOST
+        val visited = mutableSetOf<String>()
+        repeat(16) {
+            require(visited.add(owner))
+            values[owner]?.takeIf { it.isNotEmpty() }?.let { return@runCatching it.distinct() }
+            owner = aliases[owner] ?: return@runCatching emptyList()
+        }
+        emptyList()
+    }.getOrDefault(emptyList())
+
+    internal fun isPublicIpv4(address: String): Boolean {
+        val parts = address.split('.').map { it.toIntOrNull() ?: return false }
+        if (parts.size != 4 || parts.any { it !in 0..255 }) return false
+        val (a, b, c) = parts
+        return a !in setOf(0, 10, 127) && a < 224 &&
+            !(a == 100 && b in 64..127) && !(a == 169 && b == 254) &&
+            !(a == 172 && b in 16..31) && !(a == 192 && (b == 168 || b == 0 && c in setOf(0, 2))) &&
+            !(a == 198 && (b in 18..19 || b == 51 && c == 100)) && !(a == 203 && b == 0 && c == 113)
+    }
+}
diff --git a/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/VpnEntryFailoverPlanner.kt b/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/VpnEntryFailoverPlanner.kt
new file mode 100644
index 0000000..733761b
--- /dev/null
+++ b/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/VpnEntryFailoverPlanner.kt
@@ -0,0 +1,114 @@
+package org.olcbox.app.vpn
+
+import org.olcbox.app.data.model.VpnEntryEndpoint
+import org.olcbox.app.data.model.VpnEntryFailoverConfig
+import org.olcbox.app.data.model.VpnProfileConfig
+import java.net.URLDecoder
+
+/** Keeps saved profile identity intact; only temporary engine configurations change their dial target. */
+internal object VpnEntryFailoverPlanner {
+    fun plan(profile: VpnProfileConfig, wireGuardConfig: String? = null): VpnEntryFailoverConfig? {
+        val p = profile.normalized()
+        if (p.localSocksPort != null) return null
+        val original = when (p.normalizedType) {
+            VpnProfileConfig.TYPE_VLESS -> vlessEndpoint(p)
+            VpnProfileConfig.TYPE_AMNEZIA_WG, VpnProfileConfig.TYPE_AMNEZIA_VPN ->
+                wireGuardEndpoint(wireGuardConfig ?: p.rawConfig.orEmpty())
+            else -> null
+        } ?: return null
+        // Migrate only the deployed, mirrored entry points. Imported third-party profiles stay unchanged.
+        val managed = when (p.normalizedType) {
+            VpnProfileConfig.TYPE_VLESS -> original.host == MANAGED_VLESS_HOST && original.port == 443 &&
+                vlessQuery(p).let { it["type"]?.lowercase() in setOf("ws", "websocket") && it["security"]?.lowercase() == "tls" }
+            VpnProfileConfig.TYPE_AMNEZIA_WG, VpnProfileConfig.TYPE_AMNEZIA_VPN ->
+                original.host in MANAGED_WIREGUARD_HOSTS && original.port in MIRRORED_WIREGUARD_PORTS
+            else -> false
+        }
+        p.entryFailover?.normalizedOrNull()?.let { supplied ->
+            // Named managed profiles may carry metadata from before the provider changed its IP.
+            // A literal manual profile or a custom pair must retain its explicitly selected route.
+            if (managed && supplied.primary.host in setOf(original.host, ManagedEntryDns.PRIMARY_HOST, MANAGED_PRIMARY_IP, RETIRED_MANAGED_PRIMARY_IP) &&
+                supplied.primary.port == original.port &&
+                supplied.backup.host in setOf(MANAGED_BACKUP_HOST, MANAGED_BACKUP_IP) && supplied.backup.port == original.port)
+                return managedPair(original.port)
+            if (!original.sameDialTarget(supplied.primary)) return null
+            return supplied
+        }
+        return if (managed) managedPair(original.port) else null
+    }
+
+    fun forEndpoint(profile: VpnProfileConfig, endpoint: VpnEntryEndpoint, wireGuardConfig: String? = null): VpnProfileConfig {
+        val target = requireNotNull(endpoint.normalizedOrNull()) { "Invalid entry endpoint" }
+        return when (profile.normalizedType) {
+            VpnProfileConfig.TYPE_VLESS -> profile.copy(
+                uri = profile.uri?.let { if (it.startsWith("vless://", true)) rewriteVless(it, target) else it },
+                rawConfig = profile.rawConfig?.let { if (it.startsWith("vless://", true)) rewriteVless(it, target) else it },
+                entryFailover = null
+            )
+            VpnProfileConfig.TYPE_AMNEZIA_WG, VpnProfileConfig.TYPE_AMNEZIA_VPN -> {
+                val raw = wireGuardConfig ?: profile.rawConfig.orEmpty()
+                require(wireGuardEndpoint(raw) != null) { "Failover requires one WireGuard peer endpoint" }
+                profile.copy(uri = null, rawConfig = WIREGUARD_ENDPOINT.replace(raw) { match ->
+                    match.groupValues[1] + target.authority() + match.groupValues[3]
+                }, entryFailover = null)
+            }
+            else -> throw IllegalArgumentException("Entry failover is unsupported for this protocol")
+        }
+    }
+
+    private fun vlessUri(profile: VpnProfileConfig): String? =
+        listOfNotNull(profile.rawConfig, profile.uri).firstOrNull { it.startsWith("vless://", true) }
+
+    private fun vlessEndpoint(profile: VpnProfileConfig): VpnEntryEndpoint? {
+        val uri = vlessUri(profile) ?: return null
+        val authority = uri.substringAfter("://").substringBefore('?').substringBefore('#')
+        return parseEndpoint(authority.substringAfterLast('@', ""))
+    }
+
+    private fun vlessQuery(profile: VpnProfileConfig): Map<String, String> =
+        vlessUri(profile)?.substringAfter('?', "")?.substringBefore('#')?.split('&')?.mapNotNull { field ->
+            if ('=' !in field) null else runCatching {
+                URLDecoder.decode(field.substringBefore('='), "UTF-8") to URLDecoder.decode(field.substringAfter('='), "UTF-8")
+            }.getOrNull()
+        }?.toMap().orEmpty()
+
+    private fun wireGuardEndpoint(config: String): VpnEntryEndpoint? {
+        if (WIREGUARD_PEER.findAll(config).count() != 1) return null
+        val endpoints = WIREGUARD_ENDPOINT.findAll(config).toList()
+        return endpoints.singleOrNull()?.groupValues?.get(2)?.trim()?.let(::parseEndpoint)
+    }
+
+    private fun parseEndpoint(value: String): VpnEntryEndpoint? {
+        val separator = value.lastIndexOf(':')
+        if (separator < 1) return null
+        return VpnEntryEndpoint(value.substring(0, separator).removeSurrounding("[", "]"),
+            value.substring(separator + 1).toIntOrNull() ?: return null).normalizedOrNull()
+    }
+
+    private fun rewriteVless(uri: String, target: VpnEntryEndpoint): String {
+        val start = uri.indexOf("://") + 3
+        val end = uri.indexOfAny(charArrayOf('?', '#'), start).takeIf { it >= 0 } ?: uri.length
+        val at = uri.lastIndexOf('@', end - 1)
+        require(at >= start) { "VLESS URI has no server authority" }
+        return uri.substring(0, at + 1) + target.authority() + uri.substring(end)
+    }
+
+    private fun VpnEntryEndpoint.authority(): String = (if (':' in host) "[$host]" else host) + ":$port"
+    private fun VpnEntryEndpoint.sameDialTarget(other: VpnEntryEndpoint) = host == other.host && port == other.port
+
+    // Public aliases may temporarily point at the backup during an incident. Health checks must
+    // still reach the actual primary, so restoration can be detected without another DNS change.
+    private fun managedPair(port: Int) = VpnEntryFailoverConfig(
+        VpnEntryEndpoint(ManagedEntryDns.PRIMARY_HOST, port, "RuWeb"), VpnEntryEndpoint(MANAGED_BACKUP_IP, port, "Justhost")
+    )
+
+    private const val MANAGED_VLESS_HOST = "ru-kvn.meesharr.space"
+    private const val MANAGED_BACKUP_HOST = "jh-kvn.meesharr.space"
+    private const val MANAGED_PRIMARY_IP = ManagedEntryDns.FALLBACK_PRIMARY_IP
+    private const val RETIRED_MANAGED_PRIMARY_IP = "185.11.247.237"
+    private const val MANAGED_BACKUP_IP = "48.103.218.29"
+    private val MANAGED_WIREGUARD_HOSTS = setOf(MANAGED_VLESS_HOST, "awg-legacy-primary.meesharr.space")
+    private val MIRRORED_WIREGUARD_PORTS = setOf(8443, 18443, 28443, 43559, 49311, 49312, 55424)
+    private val WIREGUARD_PEER = Regex("""^\s*\[\s*peer\s*]\s*$""", setOf(RegexOption.IGNORE_CASE, RegexOption.MULTILINE))
+    private val WIREGUARD_ENDPOINT = Regex("""^([ \t]*Endpoint[ \t]*=[ \t]*)([^\r\n]+)(\r?)$""", setOf(RegexOption.IGNORE_CASE, RegexOption.MULTILINE))
+}
diff --git a/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/XrayEntryFailoverConfig.kt b/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/XrayEntryFailoverConfig.kt
new file mode 100644
index 0000000..268d635
--- /dev/null
+++ b/sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/XrayEntryFailoverConfig.kt
@@ -0,0 +1,203 @@
+package org.olcbox.app.vpn
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.put
+import org.olcbox.app.data.model.VpnEntryEndpoint
+import org.olcbox.app.data.model.VpnProfileConfig
+
+/** A stable authenticated SOCKS front. Entry health and priority belong to the session policy. */
+internal object XrayEntryFailoverConfig {
+    const val PRIMARY_TAG = "entry-primary"
+    const val BACKUP_TAG = "entry-backup"
+    const val BLOCK_TAG = "entry-block"
+    const val BALANCER_TAG = "entry-auto"
+    private const val MAIN_TAG = "entry-main"
+    private const val PRIMARY_PROBE_TAG = "entry-probe-primary"
+    private const val BACKUP_PROBE_TAG = "entry-probe-backup"
+    private const val BOOTSTRAP_TAG = "entry-bootstrap"
+    private const val BOOTSTRAP_OUTBOUND_TAG = "entry-bootstrap-dns"
+    private val bootstrapResolvers = listOf("1.1.1.1", "8.8.8.8")
+    private val json = Json { prettyPrint = true }
+
+    fun buildVless(
+        profile: VpnProfileConfig,
+        mainSocks: XraySocksSettings,
+        primaryEndpoint: VpnEntryEndpoint,
+        backupEndpoint: VpnEntryEndpoint,
+        primaryProbeSocks: XraySocksSettings,
+        backupProbeSocks: XraySocksSettings,
+        apiSocketPath: String
+    ): String {
+        val primary = primaryEndpoint.normalizedOrNull() ?: error("Invalid primary entry endpoint")
+        val backup = backupEndpoint.normalizedOrNull() ?: error("Invalid backup entry endpoint")
+        require(primary.host != backup.host || primary.port != backup.port) { "Entry endpoints must differ" }
+        require(XrayVlessConfig.downloadEndpointHost(profile) == null) {
+            "Entry failover cannot replace a separate XHTTP download endpoint"
+        }
+        validatePorts(mainSocks, primaryProbeSocks, backupProbeSocks)
+        val cleanProfile = profile.copy(entryFailover = null)
+        val bootstrapDomains = listOf(primary.host, backup.host).filterNot(::isIpLiteral).distinct()
+        fun outbound(endpoint: VpnEntryEndpoint, tag: String): JsonObject {
+            val base = Json.parseToJsonElement(XrayVlessConfig.build(cleanProfile, mainSocks,
+                endpointAddress = endpoint.host)).jsonObject
+            val original = base.getValue("outbounds").jsonArray.first().jsonObject
+            val stream = original.getValue("streamSettings").jsonObject
+            require(stream["security"] in setOf(JsonPrimitive("tls"), JsonPrimitive("reality"))) {
+                "Entry failover requires verified transport security"
+            }
+            require(stream["tlsSettings"]?.jsonObject?.get("allowInsecure") != JsonPrimitive(true)) {
+                "Entry failover requires certificate verification"
+            }
+            val settings = original.getValue("settings").jsonObject
+            val peers = settings.getValue("vnext").jsonArray
+            require(peers.size == 1) { "Entry failover requires one VLESS credential" }
+            val peer = JsonObject(peers.single().jsonObject + ("port" to JsonPrimitive(endpoint.port)))
+            val pinnedSettings = JsonObject(settings + ("vnext" to JsonArray(listOf(peer))))
+            val entryStream = if (isIpLiteral(endpoint.host)) stream else JsonObject(stream +
+                ("sockopt" to buildJsonObject { put("domainStrategy", "UseIPv4") }))
+            return JsonObject(original + mapOf(
+                "tag" to JsonPrimitive(tag),
+                "settings" to pinnedSettings,
+                "streamSettings" to entryStream))
+        }
+        return render(mainSocks, listOf(
+            inbound(primaryProbeSocks, PRIMARY_PROBE_TAG), inbound(backupProbeSocks, BACKUP_PROBE_TAG)
+        ), listOf(outbound(primary, PRIMARY_TAG), outbound(backup, BACKUP_TAG)), apiSocketPath, bootstrapDomains)
+    }
+
+    fun buildSocks(
+        mainSocks: XraySocksSettings,
+        primaryBackendSocks: XraySocksSettings,
+        backupBackendSocks: XraySocksSettings,
+        apiSocketPath: String
+    ): String {
+        validatePorts(mainSocks, primaryBackendSocks, backupBackendSocks)
+        fun outbound(settings: XraySocksSettings, tag: String) = buildJsonObject {
+            put("tag", tag)
+            put("protocol", "socks")
+            put("settings", buildJsonObject {
+                put("servers", buildJsonArray { add(buildJsonObject {
+                    put("address", settings.host)
+                    put("port", settings.port)
+                    put("users", buildJsonArray { add(buildJsonObject {
+                        put("user", settings.username)
+                        put("pass", settings.password)
+                    }) })
+                }) })
+            })
+        }
+        return render(mainSocks, emptyList(), listOf(outbound(primaryBackendSocks, PRIMARY_TAG),
+            outbound(backupBackendSocks, BACKUP_TAG)), apiSocketPath)
+    }
+
+    private fun validatePorts(vararg endpoints: XraySocksSettings) {
+        require(endpoints.map { it.port }.distinct().size == endpoints.size) { "Entry SOCKS ports must differ" }
+        for (endpoint in endpoints) {
+            require(endpoint.host in setOf("127.0.0.1", "::1")) { "Entry SOCKS must listen on loopback" }
+            require(endpoint.port in 1..65535) { "Invalid entry SOCKS port" }
+            require(endpoint.username.isNotBlank() && endpoint.password.isNotBlank()) {
+                "Entry SOCKS authentication is required"
+            }
+        }
+    }
+
+    private fun isIpLiteral(host: String): Boolean = ':' in host || host.split('.').let { octets ->
+        octets.size == 4 && octets.all { octet -> octet.toIntOrNull()?.let { it in 0..255 } == true }
+    }
+
+    private fun inbound(settings: XraySocksSettings, tag: String): JsonObject = buildJsonObject {
+        put("tag", tag)
+        put("listen", settings.host)
+        put("port", settings.port)
+        put("protocol", "socks")
+        put("settings", buildJsonObject {
+            put("udp", true)
+            put("auth", "password")
+            put("accounts", buildJsonArray { add(buildJsonObject {
+                put("user", settings.username)
+                put("pass", settings.password)
+            }) })
+        })
+    }
+
+    private fun render(
+        mainSocks: XraySocksSettings,
+        probes: List<JsonObject>,
+        entries: List<JsonObject>,
+        apiSocketPath: String,
+        bootstrapDomains: List<String> = emptyList()
+    ): String {
+        require(apiSocketPath.startsWith('/') && !apiSocketPath.endsWith('/') &&
+            apiSocketPath.encodeToByteArray().size <= 100 &&
+            apiSocketPath.split('/').none { it == "." || it == ".." } &&
+            apiSocketPath.none { it.code < 32 || it == ',' || it == '\\' }) {
+            "Entry control requires a short absolute private filesystem socket"
+        }
+        fun rule(inboundTag: String, outboundTag: String? = null) = buildJsonObject {
+            put("type", "field")
+            put("inboundTag", buildJsonArray { add(JsonPrimitive(inboundTag)) })
+            put("network", "tcp,udp")
+            if (outboundTag != null) put("outboundTag", outboundTag) else put("balancerTag", BALANCER_TAG)
+        }
+        val root = buildJsonObject {
+            put("log", buildJsonObject { put("loglevel", "warning"); put("dnsLog", false) })
+            put("api", buildJsonObject {
+                put("tag", "entry-control")
+                put("listen", "$apiSocketPath,0600")
+                put("services", buildJsonArray { add(JsonPrimitive("RoutingService")) })
+            })
+            // RoutingService itself requires the stats feature, not the StatsService API.
+            put("stats", buildJsonObject { })
+            if (bootstrapDomains.isNotEmpty()) put("dns", buildJsonObject {
+                // Only the core's entry hostname lookups carry this private, non-listening inbound tag.
+                put("tag", BOOTSTRAP_TAG)
+                put("queryStrategy", "UseIPv4")
+                put("disableFallback", true)
+                put("servers", buildJsonArray { bootstrapResolvers.forEach { resolver -> add(buildJsonObject {
+                    put("address", resolver); put("port", 53); put("skipFallback", true)
+                    put("domains", buildJsonArray { bootstrapDomains.forEach { add(JsonPrimitive("full:$it")) } })
+                }) } })
+            })
+            put("inbounds", buildJsonArray { add(inbound(mainSocks, MAIN_TAG)); probes.forEach(::add) })
+            put("outbounds", buildJsonArray {
+                add(buildJsonObject { put("tag", BLOCK_TAG); put("protocol", "blackhole") })
+                entries.forEach(::add)
+                if (bootstrapDomains.isNotEmpty()) add(buildJsonObject {
+                    put("tag", BOOTSTRAP_OUTBOUND_TAG); put("protocol", "freedom")
+                })
+            })
+            put("routing", buildJsonObject {
+                put("domainStrategy", "AsIs")
+                put("rules", buildJsonArray {
+                    if (bootstrapDomains.isNotEmpty()) add(buildJsonObject {
+                        put("type", "field")
+                        put("inboundTag", buildJsonArray { add(JsonPrimitive(BOOTSTRAP_TAG)) })
+                        put("ip", buildJsonArray { bootstrapResolvers.forEach { add(JsonPrimitive(it)) } })
+                        put("port", "53"); put("network", "tcp,udp")
+                        put("outboundTag", BOOTSTRAP_OUTBOUND_TAG)
+                    })
+                    if (probes.isNotEmpty()) {
+                        add(rule(PRIMARY_PROBE_TAG, PRIMARY_TAG))
+                        add(rule(BACKUP_PROBE_TAG, BACKUP_TAG))
+                    }
+                    add(rule(MAIN_TAG))
+                })
+                put("balancers", buildJsonArray { add(buildJsonObject {
+                    put("tag", BALANCER_TAG)
+                    // A healthy entry is selected only by an acknowledged API override.
+                    put("selector", buildJsonArray { add(JsonPrimitive(BLOCK_TAG)) })
+                    put("strategy", buildJsonObject { put("type", "random") })
+                }) })
+            })
+        }
+        return json.encodeToString(JsonElement.serializer(), root)
+    }
+}
