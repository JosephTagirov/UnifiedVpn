diff --git a/sharedUI/src/jvmTest/kotlin/org/olcbox/app/vpn/desktop/DesktopRoutedAwgProcessTest.kt b/sharedUI/src/jvmTest/kotlin/org/olcbox/app/vpn/desktop/DesktopRoutedAwgProcessTest.kt
