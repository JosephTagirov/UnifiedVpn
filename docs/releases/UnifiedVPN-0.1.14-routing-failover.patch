--- /dev/null
+++ b/tools/GenerateClientDirectPolicy.py
@@ -0,0 +1,53 @@
+"""Generate the shared Android/JVM service policy from the checked public registry dataset."""
+from pathlib import Path
+import argparse,base64,gzip,hashlib,io,json
+
+REPO=Path(__file__).resolve().parent.parent
+
+def rendered(data):
+    rules=data['direct_domains']
+    if not(28<=len(rules)<=131072 and len(rules)==len(set(rules))):
+        raise ValueError('Invalid or duplicate domain rules')
+    if data['direct_ip_cidrs']:
+        raise ValueError('This policy intentionally contains domains, not shared IP ranges')
+    if not all(isinstance(rule,str)and rule.startswith(('domain:','full:','regexp:'))and len(rule)<512 and not any(ord(c)<32 for c in rule)for rule in rules):
+        raise ValueError('Invalid domain matcher')
+    if set(rules)&{'domain:ru','domain:su','domain:xn--p1ai','domain:com','domain:net','regexp:.*'}:
+        raise ValueError('A public top-level suffix is not a service allowlist')
+    canonical=json.dumps(data,ensure_ascii=False,indent=2)+'\n'
+    digest=hashlib.sha256(canonical.encode()).hexdigest()
+    stream=io.BytesIO()
+    with gzip.GzipFile(fileobj=stream,mode='wb',filename='',mtime=0,compresslevel=9)as archive:
+        archive.write(json.dumps(rules,ensure_ascii=True,separators=(',',':')).encode())
+    encoded=base64.b64encode(stream.getvalue()).decode()
+    def quote(value):return json.dumps(value,ensure_ascii=True).replace('$',r'\$')
+    lines=['package org.olcbox.app.vpn','',
+        'import java.io.ByteArrayInputStream','import java.util.zip.GZIPInputStream','import kotlin.io.encoding.Base64',
+        'import kotlinx.serialization.json.Json','import kotlinx.serialization.json.jsonArray','import kotlinx.serialization.json.jsonPrimitive','',
+        '/** Generated from tools/client-direct-policy.json; run tools/GenerateClientDirectPolicy.py to update. */',
+        'internal object ClientDirectPolicy {',f'    const val SHA256 = "{digest}"',
+        '    val domainRules: List<String> by lazy {',
+        '        val compressed = Base64.decode(parts.joinToString(""))',
+        '        val text = GZIPInputStream(ByteArrayInputStream(compressed)).use { it.readBytes().toString(Charsets.UTF_8) }',
+        '        Json.parseToJsonElement(text).jsonArray.map { it.jsonPrimitive.content }','    }',
+        '    private val parts = arrayOf(']
+    lines+=['        '+quote(encoded[index:index+8192])+','for index in range(0,len(encoded),8192)]
+    lines+=['    )','}']
+    return canonical,'\n'.join(lines)+'\n',digest,len(rules)
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--input',type=Path,default=REPO/'tools/client-direct-policy.json')
+    parser.add_argument('--check',action='store_true')
+    args=parser.parse_args()
+    canonical,source,digest,count=rendered(json.loads(args.input.read_text(encoding='utf-8')))
+    data_path=REPO/'tools/client-direct-policy.json'
+    kotlin_path=REPO/'sharedUI/src/jvmAndAndroidMain/kotlin/org/olcbox/app/vpn/ClientDirectPolicy.kt'
+    if args.check:
+        if data_path.read_text(encoding='utf-8')!=canonical or kotlin_path.read_text(encoding='utf-8')!=source:
+            raise SystemExit('Generated direct policy is stale')
+    else:
+        data_path.write_text(canonical,encoding='utf-8');kotlin_path.write_text(source,encoding='utf-8')
+    print(json.dumps({'rules':count,'policySHA256':digest,'checked':args.check}))
+
+if __name__=='__main__':main()
diff --git a/tools/Test-HevUdpDestinationIsolation.py b/tools/Test-HevUdpDestinationIsolation.py
new file mode 100644
index 0000000..177c861
--- /dev/null
+++ b/tools/Test-HevUdpDestinationIsolation.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""Run the real HEV/lwIP pretend-PCB tuple logic on Windows without installing routes or a C runtime.
+
+Uses the project's pinned Android NDK clang plus lld to build a freestanding host DLL.
+The test compiles real production lwIP headers and private helpers in IPv4, IPv6 and
+dual-stack modes. A source-only mutation must reproduce the old destination-mixing bug.
+"""
+from __future__ import annotations
+
+import argparse
+import ctypes
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    project = Path(__file__).resolve().parent.parent
+    output = (args.output or project / 'build/native-tests/hev-udp').resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    if os.name != 'nt':
+        raise RuntimeError('This freestanding host runner targets Windows; use the same C harness with a host compiler on other systems')
+    local = (project / 'local.properties').read_text()
+    sdk = Path(re.search(r'^sdk\.dir=(.+)$', local, re.M)[1].strip().replace('\\:', ':').replace('\\\\', '\\'))
+    ndk = sdk / 'ndk/28.2.13676358'
+    if 'Pkg.Revision = 28.2.13676358' not in (ndk / 'source.properties').read_text():
+        raise RuntimeError('The pinned Android NDK is required')
+    binary = ndk / 'toolchains/llvm/prebuilt/windows-x86_64/bin'
+    clang, linker = binary / 'clang.exe', binary / 'ld.lld.exe'
+    lwip = project / 'androidApp/src/main/jni/hev-socks5-tunnel/third-part/lwip/src'
+    production = lwip / 'include/lwip/priv/udp_pretend.h'
+    udp = lwip / 'core/udp.c'
+    text = udp.read_text()
+    if text.count('udp_pretend_matches_flow(pcb,') != 1 or text.count('udp_pretend_set_flow(npcb,') != 1:
+        raise RuntimeError('The compiled pretend-PCB helpers must be wired into production udp_input')
+    original = production.read_text()
+    destination_check = ' &&\n         pcb->local_port == destination_port && ip_addr_cmp(&pcb->local_ip, destination)'
+    if original.count(destination_check) != 1:
+        raise RuntimeError('Review the baseline mutation after changing production tuple matching')
+    baseline = output / 'source-only/lwip/priv/udp_pretend.h'
+    baseline.parent.mkdir(parents=True, exist_ok=True)
+    baseline.write_text(original.replace(destination_check, ''))
+    test = project / 'tools/native-tests/hev-udp'
+    cases = []
+    for name, ipv4, ipv6 in [('ipv4', 1, 0), ('ipv6', 0, 1), ('dual', 1, 1)]:
+        for fixed in (False, True):
+            label = name + ('-fixed' if fixed else '-source-only')
+            obj, dll = output / (label + '.obj'), output / (label + '.dll')
+            includes = ([] if fixed else [baseline.parents[2]]) + [test / 'compat', lwip / 'include']
+            command = [clang, '--target=x86_64-pc-windows-msvc', '-ffreestanding', '-fno-builtin',
+                '-fno-stack-protector', '-O2', '-Wall', '-Wextra', '-Wno-unused-parameter',
+                f'-DHEV_TEST_IPV4={ipv4}', f'-DHEV_TEST_IPV6={ipv6}', '-c', test / 'udp_flow_isolation.c', '-o', obj]
+            command += [argument for include in includes for argument in ('-I', include)]
+            result = subprocess.run(list(map(str, command)), capture_output=True, text=True, timeout=30)
+            (output / (label + '.compile.log')).write_text(result.stdout + result.stderr)
+            if result.returncode:
+                raise RuntimeError(result.stdout + result.stderr)
+            result = subprocess.run([str(linker), '-flavor', 'link', '/dll', '/noentry', '/nodefaultlib',
+                '/out:' + str(dll), str(obj)], capture_output=True, text=True, timeout=30)
+            if result.returncode:
+                raise RuntimeError(result.stdout + result.stderr)
+            library = ctypes.CDLL(str(dll))
+            function = library.hev_udp_isolation_regression
+            function.restype = ctypes.c_int
+            result = function()
+            expected = 26 if ipv4 and ipv6 else 12
+            if fixed and result != expected:
+                raise RuntimeError(f'{label}: production matching failed check {-result}, expected {expected} passed checks')
+            if not fixed and result != -4:
+                raise RuntimeError(f'{label}: old source-only matching did not reproduce the destination collision: {result}')
